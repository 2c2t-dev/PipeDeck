{
  "Name": "Pipedeck",
  "Description": "Control Pipedeck, the PipeWire mixer: mute channels, mixes and the people of a call, move their levels with keys or dials, choose the mix heard in your headphones and the device it is heard on.",
  "Author": "Fabien Millet",
  "URL": "https://github.com/fabienmillet/Pipedeck",
  "Version": "0.1.0",
  "SDKVersion": 2,
  "CodePaths": {
    "x86_64-unknown-linux-gnu": "x86_64-unknown-linux-gnu/bin/pipedeck-opendeck",
    "aarch64-unknown-linux-gnu": "aarch64-unknown-linux-gnu/bin/pipedeck-opendeck"
  },
  "CodePathLin": "x86_64-unknown-linux-gnu/bin/pipedeck-opendeck",
  "Icon": "icons/plugin",
  "Category": "Pipedeck",
  "CategoryIcon": "icons/category",
  "OS": [
    {
      "Platform": "linux"
    }
  ],
  "Actions": [
    {
      "UUID": "com.fabienmillet.pipedeck.channel",
      "Name": "Channel Level",
      "Tooltip": "Mute, set or adjust a channel's level, its own or in one mix",
      "Icon": "icons/channel",
      "States": [
        {
          "Image": "icons/channel"
        }
      ],
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "Icon": "icons/channel",
        "TriggerDescription": {
          "Rotate": "Adjust level",
          "Push": "Mute",
          "Touch": "Mute"
        }
      },
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "propertyInspector/index.html"
    },
    {
      "UUID": "com.fabienmillet.pipedeck.mix",
      "Name": "Mix Level",
      "Tooltip": "Mute, set or adjust a mix's level",
      "Icon": "icons/mix",
      "States": [
        {
          "Image": "icons/mix"
        }
      ],
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "Icon": "icons/mix",
        "TriggerDescription": {
          "Rotate": "Adjust level",
          "Push": "Mute",
          "Touch": "Mute"
        }
      },
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "propertyInspector/index.html"
    },
    {
      "UUID": "com.fabienmillet.pipedeck.monitor",
      "Name": "Monitor Mix",
      "Tooltip": "Choose the mix heard in your headphones, or switch between two",
      "Icon": "icons/monitor",
      "States": [
        {
          "Image": "icons/monitor"
        }
      ],
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "Icon": "icons/monitor",
        "TriggerDescription": {
          "Push": "Switch",
          "Touch": "Switch"
        }
      },
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "propertyInspector/index.html"
    },
    {
      "UUID": "com.fabienmillet.pipedeck.output",
      "Name": "Main Output Device",
      "Tooltip": "Choose the device the mixes are heard on, or switch between two",
      "Icon": "icons/output",
      "States": [
        {
          "Image": "icons/output"
        }
      ],
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "Icon": "icons/output",
        "TriggerDescription": {
          "Push": "Switch",
          "Touch": "Switch"
        }
      },
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "propertyInspector/index.html"
    },
    {
      "UUID": "com.fabienmillet.pipedeck.voice",
      "Name": "Call Voice",
      "Tooltip": "A person of the Discord call, by their place in it",
      "Icon": "icons/voice",
      "States": [
        {
          "Image": "icons/voice"
        }
      ],
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "Icon": "icons/voice",
        "TriggerDescription": {
          "Rotate": "Adjust level",
          "Push": "Mute",
          "Touch": "Mute"
        }
      },
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "propertyInspector/index.html"
    },
    {
      "UUID": "com.fabienmillet.pipedeck.call",
      "Name": "Call",
      "Tooltip": "Go to the call's profile, or back to the mixer's",
      "Icon": "icons/call",
      "States": [
        {
          "Image": "icons/call"
        }
      ],
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "Icon": "icons/call",
        "TriggerDescription": {
          "Push": "Switch",
          "Touch": "Switch"
        }
      },
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "propertyInspector/index.html"
    }
  ]
}
