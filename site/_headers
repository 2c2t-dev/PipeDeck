# The headers Cloudflare Pages sends with every file of the site.
#
# The page may load its own files and nothing else, but for Cloudflare Web
# Analytics, which Cloudflare adds to the page and which counts visits
# without cookies; and it may not be shown inside another site's frame.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; require-trusted-types-for 'script'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# The sitemap holds no script and no link anyone follows; without the
# policy, a browser shows it with its own XML viewer, which the policy
# would leave unstyled.
/sitemap.xml
  ! Content-Security-Policy

# What adds the Flatpak repository, and what installs Pipedeck from it:
# with their own types, a browser hands them to GNOME Software or Discover.
/pipedeck.flatpakrepo
  Content-Type: application/vnd.flatpak.repo
/dev._2c2t.Pipedeck.flatpakref
  Content-Type: application/vnd.flatpak.ref
